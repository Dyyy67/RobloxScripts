--=====================================================================
--  Wizard West Auto-Farm Script (Flight-Friendly + K-Toggle UI)
--=====================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

-- ---------------------------------------------------------------------
-- 1. CONFIGURATION
-- ---------------------------------------------------------------------
local CONFIG = {
    AttackAnyNPC    = false, 
    EnemyNames      = {
        "Spider", "Nightfall Spider", "NightfallSpider",
        "Dark Wizard", "DarkWizard", "Ghoul", 
        "Ice Golem", "IceGolem", "Troll", "Slime", "Bandit"
    }, 
    FarmDistance    = 300,
    AttackDistance  = 15,
    SearchInterval  = 0.5,
    UIName          = "AutoFarmUI",
    ToggleKey       = Enum.KeyCode.K -- Press K to hide/show UI
}

local player = Players.LocalPlayer
local uiEnabled = true

-- ---------------------------------------------------------------------
-- 2. HELPER FUNCTIONS
-- ---------------------------------------------------------------------
local function isValidTargetName(name)
    if CONFIG.AttackAnyNPC then return true end
    for _, enemyName in ipairs(CONFIG.EnemyNames) do
        if name == enemyName then return true end
    end
    return false
end

local function getEquippedWeapon()
    local char = player.Character
    if not char then return nil end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then return item end
    end
    return nil
end

local function findNearestMonster()
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = player.Character.HumanoidRootPart
    local nearest = nil
    local minDist = CONFIG.FarmDistance

    for _, instance in pairs(Workspace:GetChildren()) do
        if instance:IsA("Model") and isValidTargetName(instance.Name) then
            local humanoid = instance:FindFirstChildOfClass("Humanoid")
            local enemyRoot = instance:FindFirstChild("HumanoidRootPart")
            if humanoid and enemyRoot and humanoid.Health > 0 and not Players:GetPlayerFromCharacter(instance) then
                local dist = (enemyRoot.Position - rootPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = instance
                end
            end
        end
    end
    return nearest
end

local function attackEnemy(target)
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local dist = (target.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude

    if dist > CONFIG.AttackDistance then
        humanoid:MoveTo(target.HumanoidRootPart.Position)
    else
        humanoid:MoveTo(char.HumanoidRootPart.Position) 
        local weapon = getEquippedWeapon()
        if weapon then weapon:Activate() end
    end
end

-- ---------------------------------------------------------------------
-- 3. UI SETUP AND TOGGLE
-- ---------------------------------------------------------------------
local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = CONFIG.UIName
local uiLabel = Instance.new("TextLabel", screenGui)
uiLabel.Size = UDim2.new(0, 200, 0, 50)
uiLabel.Position = UDim2.new(0.5, -100, 0, 0)
uiLabel.Text = "Auto-Farm: ON (Press K to hide)"
uiLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
uiLabel.TextColor3 = Color3.fromRGB(0, 255, 255)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == CONFIG.ToggleKey then
        uiEnabled = not uiEnabled
        uiLabel.Visible = uiEnabled
    end
end)

-- ---------------------------------------------------------------------
-- 4. MAIN LOOP
-- ---------------------------------------------------------------------
while true do
    local target = findNearestMonster()
    if target then
        attackEnemy(target)
    end
    task.wait(CONFIG.SearchInterval) 
end
