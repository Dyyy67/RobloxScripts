--=====================================================================
--  Wizard West Auto-Farm Script (Equipped Weapon Only)
--=====================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

-- ---------------------------------------------------------------------
-- 1. CONFIGURATION
-- ---------------------------------------------------------------------
local CONFIG = {
    -- Set to true to attack ANY Humanoid that isn't a player.
    -- Set to false to ONLY attack the specific names in the list below.
    AttackAnyNPC    = false, 
    
    -- Wizard West enemies and Nightfall variants
    EnemyNames      = {
        "Spider", 
        "Nightfall Spider",
        "NightfallSpider",
        "Dark Wizard", 
        "DarkWizard",
        "Ghoul", 
        "Ice Golem", 
        "IceGolem",
        "Troll", 
        "Slime", 
        "Bandit"
    }, 
    
    FarmDistance    = 300,           -- Max search distance
    AttackDistance  = 15,            -- Distance to attack from (Wands have range, so 15 is safe)
    SearchInterval  = 0.5,           -- Wait time between finding new targets
    UIName          = "AutoFarmUI",
}

local player = Players.LocalPlayer

-- ---------------------------------------------------------------------
-- 2. HELPER FUNCTIONS
-- ---------------------------------------------------------------------
local function isValidTargetName(name)
    if CONFIG.AttackAnyNPC then return true end
    
    for _, enemyName in ipairs(CONFIG.EnemyNames) do
        if name == enemyName then
            return true
        end
    end
    return false
end

-- ONLY checks the character for a currently equipped tool
local function getEquippedWeapon()
    local char = player.Character
    if not char then return nil end
    
    -- When a tool is equipped, it is moved from the Backpack to the Character model
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            return item
        end
    end
    
    return nil
end

local function findNearestMonster()
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then 
        return nil 
    end
    
    local rootPart = player.Character.HumanoidRootPart
    local nearest = nil
    local minDist = CONFIG.FarmDistance

    for _, instance in pairs(Workspace:GetChildren()) do
        if instance:IsA("Model") then
            if isValidTargetName(instance.Name) then
                local humanoid = instance:FindFirstChildOfClass("Humanoid")
                local enemyRoot = instance:FindFirstChild("HumanoidRootPart")
                
                if humanoid and enemyRoot and humanoid.Health > 0 then
                    -- Ensure this is NOT a human player
                    if not Players:GetPlayerFromCharacter(instance) then
                        local dist = (enemyRoot.Position - rootPart.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            nearest = instance
                        end
                    end
                end
            end
        end
    end
    return nearest
end

local function attackEnemy(target)
    local char = player.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end

    local dist = (target.HumanoidRootPart.Position - rootPart.Position).Magnitude

    -- Move to the enemy
    if dist > CONFIG.AttackDistance then
        humanoid:MoveTo(target.HumanoidRootPart.Position)
    else
        -- Stop moving once in range
        humanoid:MoveTo(rootPart.Position) 
        
        -- Auto-detect and use ONLY the currently equipped weapon
        local weapon = getEquippedWeapon()
        if weapon then
            -- Use the weapon (Simulates clicking the mouse)
            weapon:Activate()
        end
    end
end

local function setupUI()
    local playerGui = player:WaitForChild("PlayerGui")
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = CONFIG.UIName
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui

    local uiLabel = Instance.new("TextLabel")
    uiLabel.Size = UDim2.new(0, 200, 0, 50)
    uiLabel.Position = UDim2.new(0.5, -100, 0, 0)
    uiLabel.Parent = screenGui
    uiLabel.Text = "Farming NPCs..."
    uiLabel.TextSize = 18
    uiLabel.Font = Enum.Font.GothamBold
    uiLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    uiLabel.TextColor3 = Color3.fromRGB(0, 255, 255) 
    uiLabel.BackgroundTransparency = 0.5
    uiLabel.Visible = false
    
    return uiLabel
end

-- ---------------------------------------------------------------------
-- 3. MAIN AUTO-FARM LOOP
-- ---------------------------------------------------------------------
local uiLabel = setupUI()

while true do
    local target = findNearestMonster()
    
    if target then
        uiLabel.Visible = true
        attackEnemy(target)
    else
        uiLabel.Visible = false
    end

    task.wait(CONFIG.SearchInterval) 
end
