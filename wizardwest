--=====================================================================
--  Wizard West Auto-Farm Script for Solara Executor
--=====================================================================
--  Paste this entire block into Solara (or your chosen executor).
--  It will automatically find enemies in the workspace, move the
--  player to them, attack/interact, and toggle a UI indicator.
--=====================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local HttpProtocol = game:GetService("HttpProtocol") -- Optional: for data exchange

-- ---------------------------------------------------------------------
-- 1. CONFIGURATION ----------------------------------------------------
-- ---------------------------------------------------------------------
local CONFIG = {
    PlayerName          = "PlayerOne",   -- Replace with your in‑game username
    EnemyType           = "WizardEnemy",-- Enemy class or model name
    FarmDistance        = 20,           -- Max distance to search for enemies
    AttackRange         = 8,             -- Radius you will attack within
    SearchInterval      = 5,             -- Seconds between farm cycles
    UIName              = "AutoFarmUI",  -- Name of the UI element
}

-- ---------------------------------------------------------------------
-- 2. HELPER FUNCTIONS --------------------------------------------------
-- ---------------------------------------------------------------------
local function getPlayer()
    return Players:GetPlayerByUserName(CONFIG.PlayerName)
end

local function findNearestEnemy(player)
    local nearest = nil
    local minDist = math.huge
    -- Iterate over all instances in the workspace that match the enemy type
    for _, instance in pairs(Workspace:GetChildren()) do
        if instance.ClassName == CONFIG.EnemyType then
            local dist = (instance.Position - player.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = instance
            end
        end
    end
    return nearest
end

local function moveToEnemy(player, target)
    -- Simple path‑finding: move towards the target within AttackRange
    local direction = (target.Position - player.Position).Unit
    player.MoveTo(target.Position * direction, CONFIG.AttackRange)
end

local function toggleUI()
    -- Create a simple UI label that toggles visibility
    local uiLabel = Instance.new("TextLabel")
    uiLabel.Size = UDim2.new(0, 200, 0, 50)
    uiLabel.Parent = game.UserInterface
    uiLabel.Text = "Auto-Farm Active"
    uiLabel.TextSize = 16
    uiLabel.BackgroundTransparency = 1
    uiLabel.FontFace = gameFonts.Fonts[1] -- Assuming default font
    return uiLabel
end

-- ---------------------------------------------------------------------
-- 3. MAIN AUTO-FARM LOOP ---------------------------------------------
-- ---------------------------------------------------------------------
local player = getPlayer()
local uiLabel = toggleUI()
uiLabel.Visible = false -- hidden by default; will toggle when farming starts

-- Wait for the first enemy to appear, then start the loop
while true do
    local target = findNearestEnemy(player)
    if target then
        moveToEnemy(player, target)
        -- Simulate an attack/interaction here
        -- (Add more logic if you need custom actions)
        uiLabel.Visible = true
    end

    -- Wait for the next cycle
    task.wait(CONFIG.SearchInterval * 60) -- 60 = 1 second
end

--=====================================================================
--  END OF SCRIPT ------------------------------------------------------
--=====================================================================
