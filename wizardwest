--=====================================================================
--  Wizard West Auto-Farm Script (Player-Safe Version)
--=====================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

-- ---------------------------------------------------------------------
-- 1. CONFIGURATION
-- ---------------------------------------------------------------------
local CONFIG = {
    EnemyName       = "WizardEnemy", -- The exact name of the monster to farm
    FarmDistance    = 300,           -- Max search distance
    AttackDistance  = 5,             -- How close to get before swinging weapon
    SearchInterval  = 0.5,           -- Wait time between finding new targets
    UIName          = "AutoFarmUI",
    WeaponName      = "Sword",       -- Put the exact name of your weapon here!
}

local player = Players.LocalPlayer

-- ---------------------------------------------------------------------
-- 2. HELPER FUNCTIONS
-- ---------------------------------------------------------------------
local function findNearestMonster()
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then 
        return nil 
    end
    
    local rootPart = player.Character.HumanoidRootPart
    local nearest = nil
    local minDist = CONFIG.FarmDistance

    -- Iterate over workspace to find enemies
    for _, instance in pairs(Workspace:GetChildren()) do
        if instance:IsA("Model") and instance.Name == CONFIG.EnemyName then
            local humanoid = instance:FindFirstChild("Humanoid")
            local enemyRoot = instance:FindFirstChild("HumanoidRootPart")
            
            -- Check if it has health AND is alive
            if humanoid and enemyRoot and humanoid.Health > 0 then
                
                -- CRITICAL: Ensure this is NOT a player
                if not Players:GetPlayerFromCharacter(instance) then
                    
                    local dist = (enemyRoot.Position - rootPart.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = instance
                    end
                end
            end
        end
    end
    return nearest
end

local function attackEnemy(target)
    local char = player.Character
    if not char then return end

    local humanoid = char:FindFirstChild("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end

    local dist = (target.HumanoidRootPart.Position - rootPart.Position).Magnitude

    -- 1. Move to the enemy
    if dist > CONFIG.AttackDistance then
        humanoid:MoveTo(target.HumanoidRootPart.Position)
    else
        -- 2. Stop moving once close enough
        humanoid:MoveTo(rootPart.Position) 
        
        -- 3. Equip weapon if it's in the backpack
        local weapon = player.Backpack:FindFirstChild(CONFIG.WeaponName)
        if weapon then
            humanoid:EquipTool(weapon)
        end
        
        -- 4. Use the weapon (Simulates clicking)
        local equippedWeapon = char:FindFirstChild(CONFIG.WeaponName)
        if equippedWeapon then
            equippedWeapon:Activate()
        end
    end
end

local function setupUI()
    local playerGui = player:WaitForChild("PlayerGui")
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = CONFIG.UIName
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui

    local uiLabel = Instance.new("TextLabel")
    uiLabel.Size = UDim2.new(0, 200, 0, 50)
    uiLabel.Position = UDim2.new(0.5, -100, 0, 0)
    uiLabel.Parent = screenGui
    uiLabel.Text = "Farming Monsters..."
    uiLabel.TextSize = 18
    uiLabel.Font = Enum.Font.GothamBold
    uiLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    uiLabel.TextColor3 = Color3.fromRGB(100, 255, 100) -- Green text
    uiLabel.BackgroundTransparency = 0.5
    uiLabel.Visible = false
    
    return uiLabel
end

-- ---------------------------------------------------------------------
-- 3. MAIN AUTO-FARM LOOP
-- ---------------------------------------------------------------------
local uiLabel = setupUI()

while true do
    local target = findNearestMonster()
    
    if target then
        uiLabel.Visible = true
        attackEnemy(target)
    else
        uiLabel.Visible = false
    end

    task.wait(CONFIG.SearchInterval) 
end
